# CampusMart Environment Variables

# College domain restriction (e.g., "campus.edu" allows student@campus.edu or rollno@campus.edu)
NEXT_PUBLIC_COLLEGE_DOMAIN="campus.edu"

# College name for UI branding
NEXT_PUBLIC_COLLEGE_NAME="City Tech Campus"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Used only in secured server-side admin operations, never in client code)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application URL (for email verification redirects and auth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
